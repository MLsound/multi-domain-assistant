# =============================================================================
# Knowledge Assistant — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values for your chosen provider.
# The system checks API keys in this priority order (when LLM_PROVIDER=auto):
#   Gemini → Claude → Groq → OpenRouter → Kimi → Ollama (local)
#
# Set LLM_PROVIDER=<name> to force a specific provider regardless of keys.
# =============================================================================

# --- Option 1: Google Gemini (primary, free tier available) ---
GOOGLE_API_KEY=your_gemini_api_key_here

# --- Option 2: Anthropic Claude (paid, $5 minimum deposit required) ---
# ANTHROPIC_API_KEY=your_claude_api_key_here

# --- Option 3: Groq (genuinely free tier, no credit card, best free option) ---
# Register at: https://console.groq.com
# GROQ_API_KEY=your_groq_api_key_here

# --- Option 4: OpenRouter (free :free models, diverse model choice) ---
# Register at: https://openrouter.ai
# OPENROUTER_API_KEY=your_openrouter_api_key_here

# --- Option 5: Moonshot / Kimi (verify regional access before use) ---
# Register at: https://platform.moonshot.ai/console
# MOONSHOT_API_KEY=your_kimi_api_key_here

# --- Option 6: Ollama local (no API key, requires Ollama binary) ---
# Install Ollama from: https://ollama.ai/download
# Then run: ollama pull phi3:mini
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=phi3:mini

# =============================================================================
# Provider selection (default: auto — uses first available key above)
# =============================================================================
# LLM_PROVIDER=auto

# =============================================================================
# Optional: LangSmith observability tracing
# =============================================================================
# LANGCHAIN_API_KEY=your_langsmith_api_key_here
# ENABLE_TRACING=true

# =============================================================================
# Optional: Automated webhook action (Action Agent)
# =============================================================================
# WEBHOOK_URL=https://your-webhook-endpoint.example.com/events

# =============================================================================
# Authentication (own implementation — JWT + SQLite)
# =============================================================================
# Generate a strong secret with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_JWT_SECRET=change-me-in-production-please
AUTH_ACCESS_TOKEN_MINUTES=60
# AUTH_DATABASE_URL=sqlite:///data/auth.db
# For PostgreSQL: AUTH_DATABASE_URL=postgresql+psycopg://user:pass@host/dbname
